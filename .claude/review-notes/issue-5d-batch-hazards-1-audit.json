 },
 {
  "record": "hazard.falling",
  "leaf": "4218a982-b90e-59e8-b406-f715189136cd",
  "span_id": "d9ba44bd-8722-5ae8-9497-451069fcef94",
  "range": [
   296,
   404
  ],
  "text": " to make a DC 15 Strength (Athletics) or Dexterity (Acrobatics) check to hit the surface head or feet first.",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "hazard.falling",
  "leaf": "4218a982-b90e-59e8-b406-f715189136cd",
