  "disposition": "substantive",
  "kind": "F"
 },
 {
  "record": "hazard.burning",
  "leaf": "0f8c64db-a70f-5eb6-a48f-c33a634d2eea",
  "span_id": "fd456f5d-0386-5f2e-9b00-cf3154734324",
  "range": [
   174,
   201
  ],
  "text": " and rolling on the ground.",
