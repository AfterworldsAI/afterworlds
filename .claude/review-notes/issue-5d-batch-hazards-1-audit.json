  "kind": "R"
 },
 {
  "record": "hazard.burning",
  "leaf": "0f8c64db-a70f-5eb6-a48f-c33a634d2eea",
  "span_id": "738a136a-dec6-5c65-8514-ae3bd6ff59b9",
  "range": [
