  "kind": "U"
 },
 {
  "record": "hazard.falling",
  "leaf": "4218a982-b90e-59e8-b406-f715189136cd",
  "span_id": "f2ce1b7d-95dd-5d22-826c-aca7a74b112a",
  "range": [
   224,
   296
  ],
  "text": " A creature that falls into water or another liquid can use its Reaction",
