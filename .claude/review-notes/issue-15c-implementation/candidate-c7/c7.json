 "interpretations": {
  "I1": {
   "basis": "the table row names the Sling; the source states no other link",
   "claim": "Sling bullets are the bullets for the Sling.",
   "evidence": [
    {
     "file": "equipment.md",
     "line": 1239,
     "quote": "Bullets, Sling"
    },
    {
     "file": "equipment.md",
     "line": 241,
     "quote": "Ammunition (Range 30/120; Bullet)"
    }
   ]
  },
  "I2": {
   "alternative_if_rejected": "the firearm row carries kind bullet with no weapon link; the Musket and Pistol then have no compatible ammunition item and stay missing_authority; the Sling is unaffected",
   "basis": "the source never labels the Musket or Pistol a firearm; the only support is character-creation.md's reference to firearms described in Equipment, whose only gunpowder weapons are those two",
   "claim": "Firearm bullets are the bullets for the Musket and the Pistol.",
   "evidence": [
    {
     "file": "equipment.md",
     "line": 1232,
     "quote": "Bullets, Firearm"
    },
    {
     "file": "character-creation.md",
     "line": 849,
     "quote": "the firearms described in \"Equipment\""
    }
   ]
  },
  "I3": {
   "basis": "the Ammunition section names the table rows as the types",
   "claim": "An unqualified table row is the ammunition its singular weapon-side kind names (Arrows - Arrow, Bolts - Bolt, Needles - Needle).",
   "evidence": [
    {
     "file": "equipment.md",
     "line": 778,
     "quote": "A weapon's description specifies the type of ammunition used by the weapon"
    }
   ]
  }
 },
