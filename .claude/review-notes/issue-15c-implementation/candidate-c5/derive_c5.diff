+def dispose_entry(e: dict[str, Any]) -> None:
+    """Replace whole-clause residue with per-piece dispositions. Typed pieces
+    stay in the source entry (``clauses``); dispositions are capability."""
+    body = e.get("attack") or e.get("save")
