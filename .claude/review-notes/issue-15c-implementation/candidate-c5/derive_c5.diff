+def _norm_piece(p: str) -> str:
+    t = re.sub(r"[;,]\s*and$", "", p.strip()).strip(" ,;")
+    t = re.sub(r"^(?:and|but)\s+(?=(?:the|it|its|has|repeats|takes|can't|is)\b)", "", t)
+    return t.rstrip(".").strip()
+
