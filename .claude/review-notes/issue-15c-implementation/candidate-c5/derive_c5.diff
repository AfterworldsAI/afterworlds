+def _applied(t: dict[str, Any]) -> set[str]:
+    out = {x["condition"] for x in t.get("effects", []) if x.get("family") == "condition_effect"}
+    if t["family"] == "grapple":
+        out.add("grappled")
+    if t["family"] == "named_effect":
+        out.add(t["name"])
+    return out
