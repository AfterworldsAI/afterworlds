  "range": [
   0,
   31
  ],
  "text": "When you take the Magic action,",
  "disposition": "substantive",
  "kind": "F"
 },
 {
  "record": "action.magic",
  "leaf": "e3f3f5e1-fded-574a-8702-986eecb7c35f",
  "span_id": "ae1ad647-9721-543d-8614-04a8e7762f9e",
  "range": [
   31,
   162
  ],
  "text": " you cast a spell that has a casting time of an action or use a feature or magic item that requires a Magic action to be activated.",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.magic",
  "leaf": "b196aa1b-4e06-5e14-b1a5-1fd930e1d2da",
  "span_id": "8fb7f838-d357-57d5-a3fe-8c1dac677cf0",
  "range": [
   0,
   180
  ],
  "text": "If you cast a spell that has a casting time of 1 minute or longer, you must take the Magic action on each turn of that casting, and you must maintain Concentration while you do so.",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.magic",
  "leaf": "b196aa1b-4e06-5e14-b1a5-1fd930e1d2da",
  "span_id": "483ccdbb-46b0-5c72-bb2d-10551a71ce94",
  "range": [
   180,
   265
  ],
  "text": " If your Concentration is broken, the spell fails, but you don’t expend a spell slot.",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.magic",
  "leaf": "a874caf3-9c4d-5dd6-8b4a-5319fd2817c7",
  "span_id": "ed67d129-5b3e-5d08-b42a-5714db11f3a2",
  "range": [
   0,
   8
  ],
  "text": "See also",
  "disposition": "supporting_authority",
  "kind": "R"
 },
 {
