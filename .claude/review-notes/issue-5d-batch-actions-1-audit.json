  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.help",
  "leaf": "698a60f6-6ea3-5966-9078-85ee1994f0b3",
  "span_id": "a5773ce3-7c1a-5dfc-9d91-3ecd0fb87d3e",
  "range": [
