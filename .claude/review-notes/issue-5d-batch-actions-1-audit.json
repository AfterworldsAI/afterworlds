 {
  "record": "action.attack",
  "leaf": "acb1965b-c900-57c6-b7ad-5fb627a876a7",
  "span_id": "e9875a1a-8d2b-595c-bbb1-941cbd3760e6",
  "range": [
   0,
   15
  ],
  "text": "Attack [Action]",
  "disposition": "supporting_authority",
  "kind": "R"
 },
 {
  "record": "action.attack",
  "leaf": "c33a980f-7f42-5359-99e0-6d276d217764",
  "span_id": "c4932f98-61ed-5af1-ba24-8d0add392778",
  "range": [
   0,
   32
  ],
  "text": "When you take the Attack action,",
  "disposition": "substantive",
  "kind": "F"
 },
 {
  "record": "action.attack",
  "leaf": "c33a980f-7f42-5359-99e0-6d276d217764",
  "span_id": "9e5570cc-2ad1-5122-9cfd-e9e6f5f387fe",
  "range": [
   32,
   97
  ],
  "text": " you can make one attack roll with a weapon or an Unarmed Strike.",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.attack",
  "leaf": "e3f9e1e6-70c7-5931-904b-3ba4ce7cd79b",
  "span_id": "0df10445-d77e-5f3c-8ca5-486656f70153",
  "range": [
   0,
   34
  ],
  "text": "Equipping and Unequipping Weapons.",
  "disposition": "supporting_authority",
  "kind": "R"
 },
 {
  "record": "action.attack",
  "leaf": "50b01659-82b4-599d-b294-23c727030bb4",
  "span_id": "cd4f910e-f9b2-5334-8269-c0863d0f9449",
  "range": [
   0,
   217
  ],
  "text": "You can either equip or unequip one weapon when you make an attack as part of this action. You do so either before or after the attack. If you equip a weapon before an attack, you don’t need to use it for that attack.",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.attack",
  "leaf": "50b01659-82b4-599d-b294-23c727030bb4",
  "span_id": "ee98695f-3109-523b-af60-c46eaac9d6f4",
  "range": [
   217,
   354
  ],
  "text": " Equipping a weapon includes drawing it from a sheath or picking it up. Unequipping a weapon includes sheathing, stowing, or dropping it.",
  "disposition": "supporting_authority",
  "kind": "R"
 },
 {
  "record": "action.attack",
  "leaf": "7aed0944-935d-56db-b6e0-e847971d4fff",
  "span_id": "6ca5b063-ea60-50ff-b89a-a50f1d377bf3",
  "range": [
   0,
   23
  ],
  "text": "Moving between Attacks.",
  "disposition": "supporting_authority",
  "kind": "R"
 },
 {
  "record": "action.attack",
  "leaf": "2a4a9331-f52b-5d86-9e68-e1242e49eb49",
  "span_id": "f58929d6-8570-5fe7-9e5d-a6ede7ab9d92",
  "range": [
   0,
   204
  ],
  "text": "If you move on your turn and have a feature, such as Extra Attack, that gives you more than one attack as part of the Attack action, you can use some or all of that movement to move between those attacks.",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.dash",
  "leaf": "e7a2204d-414c-5ef9-b9f1-708db8f372ed",
  "span_id": "3c5577f5-ce87-5ce7-b053-3375933e8220",
  "range": [
   0,
   13
  ],
  "text": "Dash [Action]",
  "disposition": "supporting_authority",
  "kind": "R"
 },
 {
  "record": "action.dash",
  "leaf": "2dc8c968-bec7-5510-ab10-929b182750ed",
  "span_id": "f4ec1a37-50ba-5646-95cb-aa711f3dbe60",
  "range": [
   0,
   30
  ],
  "text": "When you take the Dash action,",
  "disposition": "substantive",
  "kind": "F"
 },
 {
  "record": "action.dash",
  "leaf": "2dc8c968-bec7-5510-ab10-929b182750ed",
  "span_id": "393b0194-34b5-59de-a24c-8d1355b407dc",
  "range": [
   30,
   137
  ],
  "text": " you gain extra movement for the current turn. The increase equals your Speed after applying any modifiers.",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.dash",
  "leaf": "2dc8c968-bec7-5510-ab10-929b182750ed",
  "span_id": "e9c6276b-1080-575f-90d8-5e790138a0fa",
  "range": [
   137,
   144
  ],
  "text": " With a",
  "disposition": "supporting_authority",
  "kind": "R"
 },
 {
  "record": "action.dash",
  "leaf": "c5e32691-8ec5-5150-8369-5dfa0cb381b5",
  "span_id": "f2c1d232-2c04-5b3f-b608-e5d36ce5885b",
  "range": [
   0,
   49
  ],
  "text": "Speed of 30 feet, for example, you can move up to",
  "disposition": "supporting_authority",
  "kind": "R"
 },
 {
  "record": "action.dash",
  "leaf": "4524429a-4c85-5159-b92a-0af217da998b",
  "span_id": "78fd717e-edd2-5448-8b7a-164d3e2072f8",
  "range": [
   0,
   131
  ],
  "text": "60 feet on your turn if you Dash. If your Speed of 30 feet is reduced to 15 feet, you can move up to 30 feet this turn if you Dash.",
  "disposition": "supporting_authority",
  "kind": "R"
 },
 {
  "record": "action.dash",
  "leaf": "4524429a-4c85-5159-b92a-0af217da998b",
  "span_id": "61c6031a-1d54-5172-86e7-916258c5d0ad",
  "range": [
   131,
   234
  ],
  "text": " If you have a special speed, such as a Fly Speed or Swim Speed, you can use that speed instead of your",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.dash",
  "leaf": "baa8bf30-7f61-5d58-b36b-ad3cfc49d85d",
  "span_id": "a4410294-444c-5519-8882-bbb66d8f6881",
  "range": [
   0,
   49
  ],
  "text": "Speed when you take this action. You choose which",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.dash",
  "leaf": "e4ba97fe-c01e-5dd0-a664-66af39750b88",
  "span_id": "02520181-45ae-5b7e-90c0-7b95498ffb4f",
  "range": [
   0,
   35
  ],
  "text": "speed to use each time you take it.",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.dash",
  "leaf": "869c0a0b-93a3-58e2-9f40-b60d6da1f56b",
  "span_id": "6f1a1b9f-0acc-5d70-af44-a2f78ec03616",
  "range": [
   0,
   8
  ],
  "text": "See also",
  "disposition": "supporting_authority",
  "kind": "R"
 },
 {
  "record": "action.dash",
  "leaf": "319ae274-cae6-58aa-9184-26a6940bf266",
  "span_id": "2a361474-64b4-556f-9c3b-276e3253c435",
  "range": [
   0,
   8
  ],
  "text": "“Speed.”",
  "disposition": "supporting_authority",
  "kind": "R"
 },
 {
  "record": "action.disengage",
  "leaf": "db909b80-7d4e-5b41-aab6-ae67270f10ef",
  "span_id": "24c88490-0154-5c91-a0ad-9250dfd9f769",
  "range": [
   0,
   18
  ],
  "text": "Disengage [Action]",
  "disposition": "supporting_authority",
  "kind": "R"
 },
 {
  "record": "action.disengage",
  "leaf": "e65d8a7b-f1dd-5f29-8c8f-66c5f048ebc4",
  "span_id": "024c39a4-e13e-5a8c-9bdc-6a3c2651c7e9",
  "range": [
   0,
   33
  ],
  "text": "If you take the Disengage action,",
  "disposition": "substantive",
  "kind": "F"
 },
 {
  "record": "action.disengage",
  "leaf": "e65d8a7b-f1dd-5f29-8c8f-66c5f048ebc4",
  "span_id": "b7a7b1a9-a7c8-509c-944a-bfb569752488",
  "range": [
   33,
   117
  ],
  "text": " your movement doesn’t provoke Opportunity Attacks for the rest of the current turn.",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.dodge",
  "leaf": "5cf65e7f-4532-53ac-981b-4b8ba1cb96f2",
  "span_id": "f540b1ed-ecf5-5e78-a5fe-b7529c7a9659",
  "range": [
   0,
   14
  ],
  "text": "Dodge [Action]",
  "disposition": "supporting_authority",
  "kind": "R"
 },
 {
  "record": "action.dodge",
  "leaf": "eed155ef-0dae-5014-b54a-a0cdfdb4df43",
  "span_id": "80cf0303-af7d-573f-bcd0-406bcb6ca73f",
  "range": [
   0,
   29
  ],
  "text": "If you take the Dodge action,",
  "disposition": "substantive",
  "kind": "F"
 },
 {
  "record": "action.dodge",
  "leaf": "eed155ef-0dae-5014-b54a-a0cdfdb4df43",
  "span_id": "3619e999-5200-5567-b1fd-6855405fbf7d",
  "range": [
   29,
   97
  ],
  "text": " you gain the following benefits: until the start of your next turn,",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.dodge",
  "leaf": "eed155ef-0dae-5014-b54a-a0cdfdb4df43",
  "span_id": "6276b892-6ef7-5093-8250-22cd9a152eb0",
  "range": [
   97,
   147
  ],
  "text": " any attack roll made against you has Disadvantage",
  "disposition": "substantive",
  "kind": "F"
 },
 {
  "record": "action.dodge",
  "leaf": "eed155ef-0dae-5014-b54a-a0cdfdb4df43",
  "span_id": "90a85555-7650-5ea5-b031-a53c7344f04f",
  "range": [
   147,
   176
  ],
  "text": " if you can see the attacker,",
  "disposition": "substantive",
  "kind": "P"
 },
 {
  "record": "action.dodge",
  "leaf": "eed155ef-0dae-5014-b54a-a0cdfdb4df43",
  "span_id": "5057ded1-8434-5af6-b215-bb1b895eec31",
  "range": [
   176,
   229
  ],
  "text": " and you make Dexterity saving throws with Advantage.",
  "disposition": "substantive",
  "kind": "F"
 },
 {
  "record": "action.dodge",
  "leaf": "eed155ef-0dae-5014-b54a-a0cdfdb4df43",
  "span_id": "a4b02c5c-255d-5c60-83c9-5914d6d8303c",
  "range": [
   229,
   316
  ],
  "text": " You lose these benefits if you have the Incapacitated condition or if your Speed is 0.",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.help",
  "leaf": "87663a42-8869-5888-82cd-3a3c5c2d8b42",
  "span_id": "12a3163c-f233-5d16-8044-a1c2a6653bf2",
  "range": [
   0,
   13
  ],
  "text": "Help [Action]",
  "disposition": "supporting_authority",
  "kind": "R"
 },
 {
  "record": "action.help",
  "leaf": "7e1a032c-9c1a-5728-a01c-f6ba5d14de40",
  "span_id": "ca87874c-e38b-5c6a-901f-04bc15314931",
  "range": [
   0,
   30
  ],
  "text": "When you take the Help action,",
  "disposition": "substantive",
  "kind": "F"
 },
 {
  "record": "action.help",
  "leaf": "7e1a032c-9c1a-5728-a01c-f6ba5d14de40",
  "span_id": "a83d57d7-f8e5-5f5a-b339-5903a1f8c671",
  "range": [
   30,
   59
  ],
  "text": " you do one of the following.",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.help",
  "leaf": "08258187-108f-5d6d-85ca-d622b9753fca",
  "span_id": "288556b3-c860-528f-80b2-f9f4c0fc3614",
  "range": [
   0,
   24
  ],
  "text": "Assist an Ability Check.",
  "disposition": "supporting_authority",
  "kind": "C"
 },
 {
  "record": "action.help",
  "leaf": "a6f0faa2-ad42-5e77-a4b7-35e4ce353d61",
  "span_id": "1d0b3b11-82da-5a5b-8feb-bc8d0dabf83d",
  "range": [
   0,
   71
  ],
  "text": "Choose one of your skill or tool proficiencies and one ally who is near",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.help",
  "leaf": "6e7c9ae8-a57e-5e9d-b2d3-42a65898fecf",
  "span_id": "f4b17d87-acf4-5cbb-84e2-44ddab77ef88",
  "range": [
   0,
   80
  ],
  "text": "enough for you to assist verbally or physically when they make an ability check.",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.help",
  "leaf": "6e7c9ae8-a57e-5e9d-b2d3-42a65898fecf",
  "span_id": "251ef6fd-53af-53b8-855b-ae5bdbfe41dc",
  "range": [
   80,
   171
  ],
  "text": " That ally has Advantage on the next ability check they make with the chosen skill or tool.",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.help",
  "leaf": "6e7c9ae8-a57e-5e9d-b2d3-42a65898fecf",
  "span_id": "07d6936a-903c-5e44-b6df-10c294013d0f",
  "range": [
   171,
   255
  ],
  "text": " This benefit expires if the ally doesn’t use it before the start of your next turn.",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
  "record": "action.help",
  "leaf": "6e7c9ae8-a57e-5e9d-b2d3-42a65898fecf",
  "span_id": "75213732-5ea1-583f-b70c-123d2ad42414",
  "range": [
   255,
   316
  ],
  "text": " The GM has final say on whether your assistance is possible.",
  "disposition": "substantive",
  "kind": "P"
 },
 {
  "record": "action.help",
  "leaf": "0c421a48-e2bc-5897-9136-eb2ff52786f3",
  "span_id": "632b002d-b305-561a-a9e3-b6978354b694",
  "range": [
   0,
   22
  ],
  "text": "Assist an Attack Roll.",
  "disposition": "supporting_authority",
  "kind": "R"
 },
 {
  "record": "action.help",
  "leaf": "698a60f6-6ea3-5966-9078-85ee1994f0b3",
  "span_id": "df47c20f-cc51-5eb5-81c4-16ed9e1b0be3",
  "range": [
   0,
   55
  ],
  "text": "You momentarily distract an enemy within 5 feet of you,",
  "disposition": "unresolved",
  "kind": "U"
 },
 {
