 "disclosed_representation_limits": [
  {
   "id": "D-1",
   "status": "admissible as declared; imprecise; for semantic review",
   "where": "hazard.malnutrition/starvation_save - ' must succeed on a DC 10 Constitution saving throw'",
   "limit": "AbilityCheckFact carries no roll-context axis, so a DC 10 Constitution saving throw and a DC 10 Constitution ability check produce byte-identical typed authority.",
   "why_emitted": "The family's docstring has declared its scope as 'a check or save with a typed DC source' since schema 1 (83abb91, #137), through two accepted reviews. Schema 4's only roll-context rule (_check_alternatives) governs the alternatives set and never runs on an empty tuple. Refusing the fact would contradict a standing declaration; leaving the span UNRESOLVED would manufacture residue as surely as emitting a false fact would manufacture zero.",
   "candidate_shape": "a RollContext axis on AbilityCheckFact",
   "prevalence": "every DC-bearing saving throw in the corpus"
  },
  {
   "id": "D-2",
   "status": "settled; recorded for completeness",
   "where": "hazard.malnutrition/starvation_automatic - ' A creature that eats nothing for 5 days'",
   "limit": "Applicability(ELAPSED_DURATION, 5, DAY) carries the duration; 'eats nothing' rides the owning record and component rather than the applicability.",
   "why_emitted": "ApplicabilityKind.ELAPSED_DURATION's own docstring cites this exact clause as its evidence. The alternative - a component applies_when plus a FactQualifier composing conjunctively - has no accepted precedent and contradicts FactQualifier's declared purpose (one fact's condition where it differs from its siblings'), so it would be the predicate language Applicability is built to refuse."
  }
 ],
