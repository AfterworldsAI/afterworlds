+def _wire_type(hint: object) -> str:
+    """A declared type as the wire sees it: vocabularies by their admitted
+    values, value objects by name only as a stand-in for their own shape (each
+    is compared separately), scalars and containers structurally."""
+    if isinstance(hint, type) and issubclass(hint, StrEnum):
+        return repr(sorted(m.value for m in hint))
+    if isinstance(hint, type):
+        return hint.__name__
+    origin, args = get_origin(hint), get_args(hint)
+    inner = ", ".join(_wire_type(a) for a in args)
+    return f"{getattr(origin, '__name__', origin)}[{inner}]"
+
+
+#: Single-value vocabularies schema 19 states on different fields, each the
+#: printed word in its own context (CRD Issue 15c native preview, provisional):
