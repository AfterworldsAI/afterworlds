+def _build_declared(cls: type) -> Callable[[Mapping[str, Any]], MechanicalFact]:
+    def build(p: Mapping[str, Any]) -> MechanicalFact:
+        hints = get_type_hints(cls)
+        family = cast(FactFamily, getattr(cls, "FAMILY"))
+        return cast(
+            MechanicalFact,
+            cls(
+                **{
+                    f.name: _declared_from_json(
+                        hints[f.name], p[f.name], f"{family.value}.{f.name}"
+                    )
+                    for f in fields(cls)
+                }
+            ),
+        )
+
+    return build
