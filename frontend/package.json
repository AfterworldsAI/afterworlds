{
  "name": "afterworlds-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "node e2e/run-isolated.mjs",
    "generate-api-types": "python ../scripts/dump_openapi_schema.py --out openapi.json && openapi-typescript openapi.json -o src/api/schema.ts && rm -f openapi.json",
    "check-api-types-drift": "npm run generate-api-types && git diff --exit-code -- src/api/schema.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "@redocly/openapi-core@1.34.17": {
      "js-yaml": "4.3.0"
    },
    "brace-expansion": "5.0.8",
    "eslint": {
      "minimatch": "^10"
    },
    "@eslint/config-array": {
      "minimatch": "^10"
    },
    "@eslint/eslintrc": {
      "minimatch": "^10"
    },
    "@redocly/openapi-core": {
      "minimatch": "^10"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
