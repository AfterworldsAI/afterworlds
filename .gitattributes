# Normalize all text files to LF in the repository.
# Git will convert to the platform's native line endings on checkout,
# but the stored content and CI always see LF.
* text=auto eol=lf

# Explicitly LF for source files
*.py    text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf

# Binary — never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary

# Pinned community source: verbatim upstream bytes, never rewritten.
# The manifest in this directory records the sha256 of each upstream Git blob,
# so a checkout that converts line endings would fail its own pin test. This
# must stay after the *.md rule above -- in .gitattributes the last match wins.
docs/sources/community/dnd-5e-srd-markdown/** -text

# Review evidence: hash-pinned receipts and logs keep their recorded bytes.
# Must stay after the text rules above -- the last match wins.
.claude/review-notes/** -text
