recursive-include src/afterworlds/modes/personas/profiles *.json
# CRD Issue 5d committed accepted oracles, resolved at runtime from the packaged
# directory. The current accepted authority is the SRD 5.2.1 release
# 5.2.1-corpus.8781d4e0-a3b. The original release 5.2.1-corpus.36b786d8-fa2 and
# the corpus table inventory were removed under Step 5 of the Recorded Owner
# Decision of 21 September 2026.
recursive-include src/afterworlds/ingestion/mechanical/oracles *.json
# Superseded intermediate releases: refused by release version before the
# directory is read, so they are kept in the source tree for test and replay
# evidence only and are not shipped. The release's predecessor artifact was
# superseded by digest (oracle.SUPERSEDED_ORACLE_SHA256) by the CRD Issue 2b G1
# successor srd-5-2-1-corpus-8781d4e0-a3b-g1.json, which is in turn superseded by
# digest by the CRD Issue 15c native C5 successor
# srd-5-2-1-corpus-8781d4e0-a3b-15c.json, itself superseded by digest by the CRD
# Issue 15c C7 successor srd-5-2-1-corpus-8781d4e0-a3b-15c-c7.json, which ships.
exclude src/afterworlds/ingestion/mechanical/oracles/srd-5-2-1-corpus-3fe24ff6-4e3.json
exclude src/afterworlds/ingestion/mechanical/oracles/srd-5-2-1-corpus-574662e9-0ef.json
exclude src/afterworlds/ingestion/mechanical/oracles/srd-5-2-1-corpus-8781d4e0-a3b.json
exclude src/afterworlds/ingestion/mechanical/oracles/srd-5-2-1-corpus-8781d4e0-a3b-g1.json
exclude src/afterworlds/ingestion/mechanical/oracles/srd-5-2-1-corpus-8781d4e0-a3b-15c.json
